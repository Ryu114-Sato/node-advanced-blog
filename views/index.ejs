<!DOCTYPE html>
<html lang="ja">
    <head>
        <title>Node Advanced Blog .</title>
        <%- include("./head"); %>
    </head>
    <body>
        <%- include("./header"); %>
        <main>
            <div class="grid-container">
                <% allBlogs.forEach((blog) => { %>
                    <div class="card">
                        <a href="blog/<%= blog._id %>" >
                            <img src="/public/images<%= blog.image %>" alt="blog-image"/>
                            <div class="texts-area">
                                <h2><%= blog.title %></h2>
                                    <p><%= blog.summary %></p>
                            </div>
                        </a>
                    </div>
                    <% }) %>
                    <div class="bpttom">
                        <% if(session !== undefined){ %>
                            <a href="/blog/create" class="create-button">Wrrite Blog</a>
                            <% } %>
                            <% if(session === undefined) { %>
                                <a href="/user/login" class="login-button">Login</a>
                            <% } %>
                            <% if(session === undefined) { %>
                                <a href="/user/create" class="user-create-button">User Create</a>
                            <% } %>
                    </div>                    
            </div>
        </main>
        <%- include("./footer"); %>
    </body>
</html>
