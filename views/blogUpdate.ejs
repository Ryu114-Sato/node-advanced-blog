<!DOCTYPE html>
<html lang="ja">
    <head>
        <title>Blog update page .</title>
        <% include("./head"); %>
    </head>
    <body>
        <% include("./header"); %>
        <main>
            <form action="/blog/update/<%= singleBlog._id %>" method="POST">
                <label for="title">Title</label>
                <input type="text" name="title" value="<%= singleBlog.title %>">
                <label for="summary">Summary</label>
                <input type="text" name="summary" value="<%= singleBlog.summary %>">
                <label for="image">Image</label>
                <input type="text" name="image" value="<%= singleBlog.image %>">
                <label for="textBody">Body</label>
                <textarea name="textBody" rows="15" ><%= singleBlog.textBody %>" </textarea>
                <br />
                <button type="submit">update</button>
            </form>
        </main>
        <% include("./footer"); %>
    </body>
</html>



