<!DOCTYPE html>
<head lang="ja">
    <title>Delete Page .</title>
    <%- include("./head"); %>
</head>

<html>
    <body>
        <%- include("./header"); %>
        <main>
            <div class="blog-delete">
                <form action="/blog/delete/<%= singleBlog._id %>" method="POST">
                    <h1><%= singleBlog.title %></h1>
                    <img src="/public/images<%= singleBlog.image %>" alt="blog-image"/>
                    <p><%= singleBlog.textBody %></p>
                    <button type="submit">
                        Delete
                    </button>
                </form>
            </div>
        </main>
        <% include("./footer"); %>
    </body>
</html>

